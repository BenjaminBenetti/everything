meta {
  name: Preserve owned profile after foreign edit
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/agents/{{ownedAgentId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Foreign editing cannot change any profile field", () => {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Bruno owned agent");
    expect(res.body.systemPrompt).to.equal("Use send_message to reply to the user.");
    expect(res.body.avatarId).to.equal("avatar-01");
  });
}
