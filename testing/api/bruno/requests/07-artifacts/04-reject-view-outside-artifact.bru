meta {
  name: Reject a view path outside the artifact
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/artifact-views
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "slug": "any-artifact",
    "path": "//elsewhere.test/"
  }
}

tests {
  test("Reject a view path outside the artifact", () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_REQUEST");
  });
}
