meta {
  name: Reject a value with a NUL character
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/keys
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "bruno-invalid-{{$timestamp}}",
    "type": "generic",
    "material": "bruno-sentinel-nul\u0000tail"
  }
}

tests {
  test("Refuse a value a process environment can't hold, without echoing it", () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_CREDENTIAL_VALUE");
    expect(JSON.stringify(res.body)).to.not.include("bruno-sentinel");
  });
}
