meta {
  name: Wrong audience token
  type: http
  seq: 5
}

post {
  url: {{tokenUrl}}
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: wrong-audience
  client_secret: {{wrongAudienceSecret}}
}

tests {
  test("Wrong audience token", () => {
    expect(res.status).to.equal(200);
    bru.setVar("wrongToken", res.body.access_token);
  });
}
