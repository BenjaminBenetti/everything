meta {
  name: Runtime is unloaded
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/agents/{{conversationAgentId}}/runtime
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Runtime is unloaded", () => {
    expect(res.status).to.equal(200);
    expect(res.body).to.deep.equal({
      status: "idle",
      compacting: false,
      sessionId: null,
      runId: null,
      error: null,
    });
  });
}
