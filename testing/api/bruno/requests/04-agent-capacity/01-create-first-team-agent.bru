meta {
  name: Create first team agent
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/agents
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bruno team first",
    "systemPrompt": "Use send_message to reply to the user."
  }
}

tests {
  test("Create first team agent", () => {
    expect(res.status).to.equal(201);
    bru.setVar("teamAgentOne", res.body.id);
  });
}
