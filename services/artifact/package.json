{
  "name": "@everything/artifact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "start": "node build/application/bootstrap/main.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build:image": "bash ../../deployment/script/build-image.sh services/artifact everything-artifact:foundation"
  },
  "dependencies": {
    "@everything/artifact-contracts": "workspace:*",
    "@everything/errors": "workspace:*",
    "@everything/persistence": "workspace:*",
    "@everything/security": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/reply-from": "12.6.5",
    "@kubernetes/client-node": "2.0.0",
    "async-lock": "1.4.1",
    "env-schema": "8.0.1",
    "fastify": "5.12.5",
    "mime-types": "3.0.2",
    "pg": "8.23.1",
    "tar-stream": "3.2.1",
    "typebox": "1.1.33",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@types/async-lock": "1.4.2",
    "@types/mime-types": "3.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/tar-stream": "3.1.4",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}
