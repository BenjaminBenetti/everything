{
  "name": "@everything/workspace-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    "./activity": {
      "types": "./build/workspace/model/activity.d.ts",
      "default": "./build/workspace/model/activity.js"
    },
    "./instance": {
      "types": "./build/workspace/model/instance.d.ts",
      "default": "./build/workspace/model/instance.js"
    },
    ".": {
      "types": "./build/workspace/schema/operations.d.ts",
      "default": "./build/workspace/schema/operations.js"
    },
    "./mount": {
      "types": "./build/workspace/model/mount.d.ts",
      "default": "./build/workspace/model/mount.js"
    },
    "./monitor": {
      "types": "./build/workspace/schema/monitor.d.ts",
      "default": "./build/workspace/schema/monitor.js"
    }
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "typebox": "1.1.33"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
