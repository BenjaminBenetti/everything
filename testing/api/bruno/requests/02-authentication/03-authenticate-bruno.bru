meta {
  name: Authenticate Bruno
  type: http
  seq: 3
}

post {
  url: {{tokenUrl}}
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: everything-bruno
  client_secret: {{brunoSecret}}
}

tests {
  if (res.status !== 200) console.log({ error: res.body.error, description: res.body.error_description });
  test("Authenticate Bruno", () => {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
    bru.setVar("accessToken", res.body.access_token);
  });
}
