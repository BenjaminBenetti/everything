meta {
  name: Reject attaching to a missing app
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/artifacts/89bb2d67-090d-405a-84f8-880d9231c9c2/credentials
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "credentialId": "{{credentialId}}",
    "env": "BRUNO_TOKEN"
  }
}

tests {
  test("A missing or foreign app looks the same", () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("ARTIFACT_NOT_FOUND");
  });
}
