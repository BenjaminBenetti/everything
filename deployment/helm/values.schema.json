{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "secrets",
    "keycloakRealm",
    "sharedVolumes",
    "serviceDefaults",
    "services"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "publicOrigin",
        "externalHostname",
        "realm",
        "databaseCredentialsSecret",
        "ingress",
        "storageClassName"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "tag", "pullPolicy"],
          "properties": {
            "registry": {
              "type": "string"
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "publicOrigin": {
          "type": "string",
          "pattern": "^https?://[^/]+$"
        },
        "externalHostname": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
        },
        "realm": {
          "type": "string",
          "minLength": 1
        },
        "databaseCredentialsSecret": {
          "type": "string",
          "minLength": 1
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dnsLabel"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "keycloakRealm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "developmentSeed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "userPasswords": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "clientSecrets": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": ["developmentSeed"]
    },
    "sharedVolumes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dnsLabel"
      },
      "additionalProperties": {
        "$ref": "#/definitions/storage"
      }
    },
    "serviceDefaults": {
      "$ref": "#/definitions/service"
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dnsLabel"
      },
      "additionalProperties": {
        "$ref": "#/definitions/service"
      }
    }
  },
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "workload": {
          "enum": ["Deployment", "StatefulSet"]
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "enum": ["Recreate", "RollingUpdate"]
        },
        "rolloutWave": {
          "type": "integer",
          "minimum": 0
        },
        "containerName": {
          "type": "string"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": ["string", "number", "boolean"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["secretName", "key"],
                "properties": {
                  "secretName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "maxLength": 15
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["containerPort"],
            "properties": {
              "containerPort": {
                "type": "integer",
                "minimum": 1
              },
              "servicePort": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "string",
              "minLength": 1
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          "dependencies": {
            "port": ["paths"],
            "paths": ["port"]
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": {
              "type": "object"
            },
            "readiness": {
              "type": "object"
            },
            "liveness": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "volumes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/dnsLabel"
          },
          "additionalProperties": {
            "$ref": "#/definitions/volume"
          }
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mountPath"],
      "properties": {
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "persistentVolume": {
          "$ref": "#/definitions/storage"
        },
        "sharedVolume": {
          "$ref": "#/definitions/dnsLabel"
        },
        "secret": {
          "type": "string",
          "minLength": 1
        },
        "emptyDir": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": ["persistentVolume"]
        },
        {
          "required": ["sharedVolume"]
        },
        {
          "required": ["secret"]
        },
        {
          "required": ["emptyDir"]
        }
      ]
    }
  }
}
