{
  "name": "@everything/conversation-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/conversation/model/conversation.d.ts",
      "default": "./build/conversation/model/conversation.js"
    },
    "./voice": {
      "types": "./build/voice/model/voice.d.ts",
      "default": "./build/voice/model/voice.js"
    },
    "./voice-stream": {
      "types": "./build/voice/model/voice-stream.d.ts",
      "default": "./build/voice/model/voice-stream.js"
    }
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
