{
  "name": "@everything/ui-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json && vite build --config src/application/config/vite.config.ts",
    "check": "tsc -p tsconfig.json",
    "dev": "vite --config src/application/config/vite.config.ts --host 0.0.0.0",
    "start": "node build/server/application/bootstrap/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build:image": "bash ../../deployment/script/build-image.sh services/ui everything-ui:foundation"
  },
  "dependencies": {
    "@everything/agent-contracts": "workspace:*",
    "@everything/provider-contracts": "workspace:*",
    "@everything/security": "workspace:*",
    "@everything/ui": "workspace:*",
    "@fastify/helmet": "13.0.2",
    "@fastify/static": "10.1.6",
    "@tanstack/react-query": "5.104.1",
    "env-schema": "8.0.1",
    "fastify": "5.12.5",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "typebox": "1.1.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
