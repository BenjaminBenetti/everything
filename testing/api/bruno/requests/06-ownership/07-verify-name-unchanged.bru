meta {
  name: Preserve owned name after foreign rename
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/agents/{{ownedAgentId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Foreign renaming cannot change the owner's definition", () => {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Bruno owned agent");
  });
}
