{
  "name": "@everything/upgrader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "start": "node build/application/bootstrap/main.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "build:image": "bash ../../deployment/script/build-image.sh services/upgrader everything-upgrader:foundation"
  },
  "dependencies": {
    "@everything/errors": "workspace:*",
    "@everything/security": "workspace:*",
    "@everything/upgrade-contracts": "workspace:*",
    "@kubernetes/client-node": "2.0.0",
    "async-lock": "1.4.1",
    "env-schema": "8.0.1",
    "fastify": "5.12.5",
    "semver": "7.8.5",
    "typebox": "1.1.33"
  },
  "devDependencies": {
    "@types/async-lock": "1.4.2",
    "@types/node": "^24.0.0",
    "@types/semver": "7.8.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
