meta {
  name: Create a generic credential
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/keys
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "bruno-credential-{{$timestamp}}",
    "type": "generic",
    "description": "Bruno test credential",
    "material": "  bruno-sentinel-4f1a\nsecond line $HOME \\ \"quoted\" ü 🔑\t "
  }
}

tests {
  test("Store the value encrypted and answer with metadata only", () => {
    expect(res.status).to.equal(201);
    expect(Object.keys(res.body).sort()).to.deep.equal([
      "createdAt",
      "description",
      "id",
      "name",
      "owned",
      "type",
      "updatedAt",
    ]);
    expect(res.body.type).to.equal("generic");
    expect(res.body.owned).to.equal(true);
    expect(JSON.stringify(res.body)).to.not.include("bruno-sentinel");
    bru.setVar("credentialId", res.body.id);
    bru.setVar("credentialName", res.body.name);
  });
}
