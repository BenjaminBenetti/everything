meta {
  name: Identity survives restart
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Identity survives restart", () => {
    expect(res.status).to.equal(200);
    expect(res.body.subject).to.equal(bru.getEnvVar("restartSubject"));
  });
}
