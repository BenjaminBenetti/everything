meta {
  name: Delete the credential
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/v1/keys/{{credentialId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Delete it and confirm no app holds it", () => {
    expect(res.status).to.equal(200);
    expect(res.body.rollout).to.deep.equal({
      complete: true,
      usage: { apps: [], otherApps: 0 },
    });
  });
}
