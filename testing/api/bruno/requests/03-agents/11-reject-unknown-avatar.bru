meta {
  name: Reject an unknown avatar
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/v1/agents/{{agentId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Invalid edit",
    "avatarId": "avatar-65"
  }
}

tests {
  test("An unknown avatar rejects the whole profile edit", () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_REQUEST");
  });
}
