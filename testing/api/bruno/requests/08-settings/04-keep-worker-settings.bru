meta {
  name: Save unchanged worker settings
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/settings/workers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "privileged": {{workersPrivileged}}
  }
}

tests {
  test("Save the current worker settings through Fleet and read them back", () => {
    expect(res.status).to.equal(200);
    expect(res.body.privileged).to.equal(bru.getVar("workersPrivileged"));
  });
}
