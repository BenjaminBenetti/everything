meta {
  name: Verify saved profile after partial and rejected edits
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/agents/{{agentId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Partial edits persist and a rejected edit changes nothing", () => {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Bruno renamed");
    expect(res.body.systemPrompt).to.equal("Final description and instructions.");
    expect(res.body.avatarId).to.equal("avatar-32");
  });
}
