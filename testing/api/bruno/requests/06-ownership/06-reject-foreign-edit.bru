meta {
  name: Reject foreign profile editing
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/v1/agents/{{ownedAgentId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{outsiderToken}}
}

body:json {
  {
    "name": "Unauthorized rename",
    "systemPrompt": "Unauthorized description",
    "avatarId": "avatar-64"
  }
}

tests {
  test("Hide the foreign definition from profile editing", () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("AGENT_NOT_FOUND");
  });
}
