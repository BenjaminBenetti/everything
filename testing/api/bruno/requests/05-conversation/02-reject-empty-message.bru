meta {
  name: Reject empty message
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/agents/{{conversationAgentId}}/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "text": ""
  }
}

tests {
  test("Reject empty message", () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal("INVALID_REQUEST");
  });
}
