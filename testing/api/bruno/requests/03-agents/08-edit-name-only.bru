meta {
  name: Preserve fields during a name-only edit
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/v1/agents/{{agentId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Bruno renamed"
  }
}

tests {
  test("A name-only edit preserves the description and avatar", () => {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Bruno renamed");
    expect(res.body.systemPrompt).to.equal("Updated description and instructions.");
    expect(res.body.avatarId).to.equal("avatar-64");
  });
}
