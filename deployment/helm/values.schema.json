{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "secrets",
    "keycloakRealm",
    "artifactRegistry",
    "fleet",
    "upgrades",
    "sharedVolumes",
    "serviceDefaults",
    "services"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "publicOrigin",
        "externalHostname",
        "realm",
        "databaseCredentialsSecret",
        "ingress",
        "storageClassName",
        "externalArtifactHostname",
        "artifactOrigin",
        "artifactIngress",
        "externalRegistryHostname",
        "registryIngress",
        "artifactNamespace",
        "buildNamespace",
        "fleetNamespace"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "tag", "pullPolicy"],
          "properties": {
            "registry": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "publicOrigin": {
          "type": "string",
          "pattern": "^https?://[^/]+$"
        },
        "artifactOrigin": {
          "type": "string",
          "pattern": "^https?://[^/]+$"
        },
        "externalHostname": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
        },
        "externalArtifactHostname": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
        },
        "externalRegistryHostname": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
        },
        "realm": {
          "type": "string",
          "minLength": 1
        },
        "databaseCredentialsSecret": {
          "type": "string",
          "minLength": 1
        },
        "ingress": {
          "$ref": "#/definitions/ingressSettings"
        },
        "artifactIngress": {
          "$ref": "#/definitions/ingressSettings"
        },
        "registryIngress": {
          "$ref": "#/definitions/ingressSettings"
        },
        "storageClassName": {
          "type": "string"
        },
        "artifactNamespace": {
          "type": "string",
          "minLength": 1
        },
        "buildNamespace": {
          "type": "string",
          "minLength": 1
        },
        "fleetNamespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dnsLabel"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "keycloakRealm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "developmentSeed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "userPasswords": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "clientSecrets": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": ["developmentSeed"]
    },
    "artifactRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialsSecret", "pushHost", "pullHost"],
      "properties": {
        "credentialsSecret": {
          "$ref": "#/definitions/dnsLabel"
        },
        "pushHost": {
          "type": "string",
          "minLength": 1
        },
        "pullHost": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "releaseUrl", "checksums"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v[0-9A-Za-z][0-9A-Za-z.+-]*$"
        },
        "releaseUrl": {
          "type": "string",
          "pattern": "^https://[^?#]*[^/?#]$"
        },
        "checksums": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fleet-linux-amd64",
            "fleet-linux-arm64",
            "fleet-pod-linux-amd64",
            "fleet-pod-linux-arm64",
            "fleet-tmux-linux-amd64.tar.gz",
            "fleet-tmux-linux-arm64.tar.gz"
          ],
          "properties": {
            "fleet-linux-amd64": {
              "$ref": "#/definitions/sha256"
            },
            "fleet-linux-arm64": {
              "$ref": "#/definitions/sha256"
            },
            "fleet-pod-linux-amd64": {
              "$ref": "#/definitions/sha256"
            },
            "fleet-pod-linux-arm64": {
              "$ref": "#/definitions/sha256"
            },
            "fleet-tmux-linux-amd64.tar.gz": {
              "$ref": "#/definitions/sha256"
            },
            "fleet-tmux-linux-arm64.tar.gz": {
              "$ref": "#/definitions/sha256"
            }
          }
        }
      }
    },
    "upgrades": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart", "settings", "tokenAudience"],
      "properties": {
        "chart": {
          "type": "string",
          "pattern": "^(oci://.+)?$"
        },
        "settings": {
          "type": "string"
        },
        "tokenAudience": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sharedVolumes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dnsLabel"
      },
      "additionalProperties": {
        "$ref": "#/definitions/storage"
      }
    },
    "serviceDefaults": {
      "$ref": "#/definitions/service"
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dnsLabel"
      },
      "additionalProperties": {
        "$ref": "#/definitions/service"
      }
    }
  },
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "upstreamImage": {
          "type": "string"
        },
        "workload": {
          "enum": ["Deployment", "StatefulSet"]
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "enum": ["Recreate", "RollingUpdate"]
        },
        "rolloutWave": {
          "type": "integer",
          "minimum": 0
        },
        "containerName": {
          "type": "string"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "ports": {
          "type": "object",
          "propertyNames": {
            "maxLength": 15
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["containerPort"],
            "properties": {
              "containerPort": {
                "type": "integer",
                "minimum": 1
              },
              "servicePort": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "string",
              "minLength": 1
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "site": {
              "enum": ["application", "artifacts", "registry"]
            }
          },
          "dependencies": {
            "port": ["paths"],
            "paths": ["port"]
          }
        },
        "apiAccess": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "clusterApiAccess": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "releaseAccess": {
          "type": "boolean"
        },
        "probes": {
          "$ref": "#/definitions/probes"
        },
        "resources": {
          "type": "object"
        },
        "volumes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/dnsLabel"
          },
          "additionalProperties": {
            "$ref": "#/definitions/volume"
          }
        },
        "sidecars": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/dnsLabel"
          },
          "additionalProperties": {
            "$ref": "#/definitions/sidecar"
          }
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOnly": {
          "type": "boolean"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "persistentVolume": {
          "$ref": "#/definitions/storage"
        },
        "sharedVolume": {
          "$ref": "#/definitions/dnsLabel"
        },
        "secret": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "string",
          "minLength": 1
        },
        "emptyDir": {
          "type": "object"
        },
        "serviceAccountToken": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audience"],
          "properties": {
            "audience": {
              "type": "string",
              "minLength": 1
            },
            "expirationSeconds": {
              "type": "integer",
              "minimum": 600
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["persistentVolume"]
        },
        {
          "required": ["sharedVolume"]
        },
        {
          "required": ["secret"]
        },
        {
          "required": ["files"]
        },
        {
          "required": ["emptyDir"]
        },
        {
          "required": ["serviceAccountToken"]
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": ["string", "number", "boolean"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretName", "key"],
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object"
        },
        "readiness": {
          "type": "object"
        },
        "liveness": {
          "type": "object"
        }
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "upstreamImage": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "$ref": "#/definitions/env"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "probes": {
          "$ref": "#/definitions/probes"
        },
        "resources": {
          "type": "object"
        },
        "volumeMounts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/dnsLabel"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^/"
          }
        }
      },
      "oneOf": [
        {
          "required": ["image"]
        },
        {
          "required": ["upstreamImage"]
        }
      ]
    },
    "ingressSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tlsSecretName": {
          "type": "string"
        }
      }
    }
  }
}
