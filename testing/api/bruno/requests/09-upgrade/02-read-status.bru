meta {
  name: Read the upgrade status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/upgrade
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Everything reaches the upgrader with its service account token", () => {
    expect(res.status).to.equal(200);
    expect(res.body.currentVersion).to.match(/^\d+\.\d+\.\d+/);
  });

  test("The development stack is upgraded by cluster:up, not from Everything", () => {
    expect(res.body.availability).to.equal("not-configured");
    expect(res.body.latestVersion).to.equal(null);
    expect(res.body.versionsChecked).to.equal(false);
    expect(res.body.lastUpgrade).to.equal(null);
  });
}
