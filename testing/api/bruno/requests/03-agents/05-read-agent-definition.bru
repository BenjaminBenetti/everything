meta {
  name: Read agent definition
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/agents/{{agentId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Read agent definition", () => {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("Bruno review");
    expect(res.body.avatarId).to.equal("avatar-01");
  });
}
