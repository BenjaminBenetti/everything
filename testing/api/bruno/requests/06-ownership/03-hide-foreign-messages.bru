meta {
  name: Hide foreign messages
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/agents/{{ownedAgentId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{outsiderToken}}
}

tests {
  test("Hide foreign messages", () => {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal("AGENT_NOT_FOUND");
  });
}
