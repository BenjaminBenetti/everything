meta {
  name: Reject an unauthenticated upgrade status read
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/upgrade
  body: none
  auth: none
}

tests {
  test("Reject an unauthenticated upgrade status read", () => {
    expect(res.status).to.equal(401);
    expect(res.body.code).to.equal("UNAUTHENTICATED");
  });
}
