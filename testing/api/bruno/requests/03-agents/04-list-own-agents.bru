meta {
  name: List own agents
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/agents
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("List own agents", () => {
    expect(res.status).to.equal(200);
    expect(res.body.agents.some(agent => agent.id === bru.getVar("agentId"))).to.equal(true);
  });
}
