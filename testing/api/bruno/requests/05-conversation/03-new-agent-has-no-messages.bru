meta {
  name: New agent has no messages
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/agents/{{conversationAgentId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("New agent has no messages", () => {
    expect(res.status).to.equal(200);
    expect(res.body.messages).to.deep.equal([]);
    expect(res.body.nextCursor).to.equal(null);
  });
}
