meta {
  name: Reject an upgrade to a malformed version
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/upgrade
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "version": "latest"
  }
}

tests {
  test("Reject a version that is not a released version", () => {
    expect(res.status).to.equal(400);
  });
}
